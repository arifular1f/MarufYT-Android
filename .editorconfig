# EditorConfig configuration for MarufYT Android
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,py}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf

[gradlew]
end_of_line = lf
